{
  "name": "beavuck-time",
  "version": "2.0.8",
  "main": "dist/app.js",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "run-integration-tests": "newman run api-tests/collection.json -e api-tests/environment.json --bail",
    "up-patch": "npm version patch --no-git-tag-version",
    "up-minor": "npm version minor --no-git-tag-version",
    "up-major": "npm version major --no-git-tag-version",
    "update-dependencies": "ncu --format group && ncu -u && npm install && npm prune && npm audit fix",
    "test": "DOTENV_CONFIG_PATH=./.env.test jest --coverage",
    "format": "prettier --write .",
    "build": "tsc",
    "start": "node dist/server.js",
    "go": "npm run test && npm run format && npm run build && npm start"
  },
  "keywords": [],
  "author": "Alexis Drai",
  "license": "Unlicense",
  "private": "false",
  "description": "Get time in ISO format, in UTC timezone, from a simple, lightweight node server",
  "homepage": "https://gitlab.com/beavuck-services/time",
  "repository": {
    "type": "git",
    "url": "git+https://gitlab.com/beavuck-services/time.git"
  },
  "bugs": "https://gitlab.com/beavuck-services/time/-/issues",
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "http-status-codes": "^2.3.0",
    "winston": "^3.14.2",
    "winston-daily-rotate-file": "^5.0.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.12",
    "@types/node": "^22.5.0",
    "@types/supertest": "^6.0.2",
    "jest": "^29.7.0",
    "nodemon": "^3.1.4",
    "npm-check-updates": "^17.1.0",
    "prettier": "3.3.3",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.4"
  }
}
