{
  "name": "beavuck-time",
  "version": "3.2.13",
  "description": "Get time in ISO format, in UTC timezone, from a simple, lightweight node server",
  "keywords": [
    "time",
    "iso",
    "high-performance",
    "microservice",
    "open source"
  ],
  "homepage": "https://gitlab.com/beavuck-services/time",
  "bugs": {
    "url": "https://gitlab.com/beavuck-services/time/-/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://gitlab.com/beavuck-services/time.git"
  },
  "license": "Unlicense",
  "author": "Alexis Drai",
  "type": "commonjs",
  "main": "build/server.js",
  "files": [
    "build/",
    "openapi/swagger.json",
    "package.json",
    "CONTRIBUTING.md",
    "README.md",
    "UNLICENSE"
  ],
  "bin": {
    "beavuck-time": "build/server.js"
  },
  "scripts": {
    "run-integration-tests": "cd api_tests/time_api_tests && npx --yes @usebruno/cli run --env local --bail",
    "up-patch": "npm version patch --no-git-tag-version",
    "up-minor": "npm version minor --no-git-tag-version",
    "up-major": "npm version major --no-git-tag-version",
    "upgrade-dependencies": "ncu --cooldown=10d --format group && ncu -u --cooldown=10d && npm run safe-install && npm prune --verbose && npm run audit",
    "audit": "npm audit fix --verbose",
    "prepublishOnly": "npm run safe-install && npm run build",
    "safe-install": "npm install --ignore-scripts --allow-git=none --min-release-age=10",
    "safe-install:ci": "npm ci --ignore-scripts --allow-git=none --min-release-age=10",
    "lint": "eslint --fix --cache --cache-location node_modules/.cache/.eslint_cache --report-unused-disable-directives --ignore-pattern .gitignore src/",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write --log-level warn --cache --cache-location node_modules/.cache/.prettier_cache src/",
    "clean": "node scripts/check-stable-deps.mjs && npm run lint && npm run typecheck && npm run format",
    "test": "node --env-file=.env.test node_modules/.bin/jest --coverage",
    "build": "tsoa spec-and-routes && tsc",
    "start": "node build/server.js",
    "go": "rm -rf build && npm run safe-install && npm run build && npm run clean && npm run test && npm run start"
  },
  "dependencies": {
    "@tsoa/runtime": "^6.6.0",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.2",
    "http-status-codes": "^2.3.0",
    "joi": "^18.2.3",
    "tsoa": "^7.0.0-alpha.0",
    "winston": "^3.19.0",
    "winston-daily-rotate-file": "^5.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.1.2",
    "@types/supertest": "^7.2.1",
    "eslint": "^10.8.0",
    "globals": "^17.9.0",
    "jest": "^30.4.2",
    "jest-util": "^30.4.1",
    "npm-check-updates": "^23.0.1",
    "prettier": "3.9.6",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.12",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.66.0"
  },
  "engines": {
    "node": ">=20.12.0"
  },
  "prettier": {
    "experimentalTernaries": true,
    "semi": false,
    "printWidth": 120,
    "tabWidth": 2,
    "useTabs": false,
    "singleQuote": true,
    "jsxSingleQuote": false,
    "bracketSameLine": false,
    "arrowParens": "avoid",
    "endOfLine": "lf",
    "bracketSpacing": false,
    "trailingComma": "all"
  },
  "allowScripts": {
    "unrs-resolver": false
  }
}
