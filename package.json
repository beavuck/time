{
  "name": "beavuck-time",
  "version": "2.1.13",
  "main": "build/api.js",
  "engines": {
    "node": ">=18.20.4"
  },
  "scripts": {
    "run-integration-tests": "cd api-tests/bruno && npm install -g @usebruno/cli && bru run --env local --bail",
    "up-patch": "npm version patch --no-git-tag-version",
    "up-minor": "npm version minor --no-git-tag-version",
    "up-major": "npm version major --no-git-tag-version",
    "update-dependencies": "ncu --format group && ncu -u && npm install --verbose && npm prune --verbose && npm audit fix --verbose",
    "lint": "eslint --fix src/",
    "format": "prettier --write src/ --log-level warn",
    "clean": "npm run lint && npm run format",
    "test": "DOTENV_CONFIG_PATH=./.env.test jest --coverage",
    "build": "tsoa spec-and-routes && tsc",
    "start": "node build/server.js",
    "go": "npm install && npm run build && npm run clean && npm run test && npm start"
  },
  "keywords": [],
  "author": "Alexis Drai",
  "license": "Unlicense",
  "private": "false",
  "description": "Get time in ISO format, in UTC timezone, from a simple, lightweight node server",
  "homepage": "https://gitlab.com/beavuck-services/time",
  "repository": {
    "type": "git",
    "url": "https://gitlab.com/beavuck-services/time.git"
  },
  "prettier": {
    "experimentalTernaries": true,
    "semi": false,
    "printWidth": 96,
    "tabWidth": 2,
    "useTabs": false,
    "singleQuote": true,
    "jsxSingleQuote": false,
    "bracketSameLine": false,
    "arrowParens": "avoid",
    "endOfLine": "lf",
    "bracketSpacing": false,
    "trailingComma": "all"
  },
  "bugs": "https://gitlab.com/beavuck-services/time/-/issues",
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.5.0",
    "express": "^5.1.0",
    "express-rate-limit": "^7.5.0",
    "http-status-codes": "^2.3.0",
    "joi": "^17.13.3",
    "tsoa": "^6.6.0",
    "winston": "^3.17.0",
    "winston-daily-rotate-file": "^5.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.29.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/jest": "^29.5.14",
    "@types/node": "^24.0.1",
    "@types/supertest": "^6.0.3",
    "eslint": "^9.29.0",
    "globals": "^16.2.0",
    "jest": "^30.0.0",
    "nodemon": "^3.1.10",
    "npm-check-updates": "^18.0.1",
    "prettier": "3.5.3",
    "supertest": "^7.1.1",
    "ts-jest": "^29.4.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.34.0"
  }
}
