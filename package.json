{
  "name": "beavuck-time",
  "version": "2.0.4",
  "main": "dist/app.js",
  "scripts": {
    "up-patch": "npm version patch --no-git-tag-version",
    "up-minor": "npm version minor --no-git-tag-version",
    "up-major": "npm version major --no-git-tag-version",
    "test": "jest --coverage",
    "format": "prettier --write .",
    "build": "tsc",
    "start": "node dist/server.js",
    "go": "npm run test && npm run format && npm run build && npm start"
  },
  "keywords": [],
  "author": "Alexis Drai",
  "license": "ISC",
  "description": "Get time in ISO format, in UTC timezone, from a simple, lightweight node server",
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "http-status-codes": "^2.3.0",
    "winston": "^3.13.1",
    "winston-daily-rotate-file": "^5.0.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.14.12",
    "jest": "^29.7.0",
    "nodemon": "^3.1.4",
    "npm-check-updates": "^16.14.20",
    "prettier": "3.3.3",
    "ts-jest": "^29.2.3",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.4"
  }
}
