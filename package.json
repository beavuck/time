{
  "name": "beavuck-time",
  "version": "2.4.10",
  "description": "Get time in ISO format, in UTC timezone, from a simple, lightweight node server",
  "keywords": [
    "time",
    "iso",
    "high-performance",
    "microservice",
    "open source"
  ],
  "homepage": "https://gitlab.com/beavuck-services/time",
  "bugs": {
    "url": "https://gitlab.com/beavuck-services/time/-/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://gitlab.com/beavuck-services/time.git"
  },
  "license": "Unlicense",
  "author": "Alexis Drai",
  "type": "commonjs",
  "main": "build/server.js",
  "files": [
    "build/",
    "openapi/swagger.json",
    "package.json",
    "CONTRIBUTING.md",
    "README.md",
    "UNLICENSE"
  ],
  "bin": {
    "beavuck-time": "build/server.js"
  },
  "scripts": {
    "run-integration-tests": "cd api-tests/bruno && npm install -g @usebruno/cli && bru run --env local --bail",
    "up-patch": "npm version patch --no-git-tag-version",
    "up-minor": "npm version minor --no-git-tag-version",
    "up-major": "npm version major --no-git-tag-version",
    "update-dependencies": "ncu --format group && ncu -u && npm install --verbose && npm prune --verbose && npm audit fix --verbose",
    "prepublishOnly": "npm install && npm run build",
    "lint": "eslint --fix src/",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write src/ --log-level warn",
    "clean": "npm run lint && npm run typecheck && npm run format",
    "test": "DOTENV_CONFIG_PATH=./.env.test jest --coverage",
    "build": "tsoa spec-and-routes && tsc",
    "start": "node build/server.js",
    "go": "rm -rf build && npm install && npm run build && npm run clean && npm run test && npm run start"
  },
  "dependencies": {
    "@dotenvx/dotenvx": "^1.51.1",
    "cors": "^2.8.5",
    "express": "^5.2.1",
    "express-rate-limit": "^8.2.1",
    "http-status-codes": "^2.3.0",
    "joi": "^18.0.2",
    "tsoa": "^6.6.0",
    "winston": "^3.18.3",
    "winston-daily-rotate-file": "^5.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.10.1",
    "@types/supertest": "^6.0.3",
    "eslint": "^9.39.1",
    "globals": "^16.5.0",
    "jest": "^30.2.0",
    "nodemon": "^3.1.11",
    "npm-check-updates": "^19.1.2",
    "prettier": "3.7.4",
    "supertest": "^7.1.4",
    "ts-jest": "^29.4.6",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.48.1"
  },
  "engines": {
    "node": ">=18.20.8"
  },
  "prettier": {
    "experimentalTernaries": true,
    "semi": false,
    "printWidth": 96,
    "tabWidth": 2,
    "useTabs": false,
    "singleQuote": true,
    "jsxSingleQuote": false,
    "bracketSameLine": false,
    "arrowParens": "avoid",
    "endOfLine": "lf",
    "bracketSpacing": false,
    "trailingComma": "all"
  }
}
