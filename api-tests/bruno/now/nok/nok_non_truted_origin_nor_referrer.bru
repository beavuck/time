meta {
  name: nok_non_truted_origin_nor_referrer
  type: http
  seq: 3
}

get {
  url: {{BASE_URL}}/now
  body: none
  auth: none
}

headers {
  Origin: {{NON_TRUSTED_ORIGIN}}
  Referrer: {{NON_RECOGNIZED_REFERRER}}
}

assert {
  res.status: eq 403
  res.body: isDefined
  res.body.message: isDefined
  res.body.message: matches {{CORS_REGEX}}
  res.responseTime: lt 200
}
