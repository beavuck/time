meta {
  name: nok_non_trusted_origin
  type: http
  seq: 1
}

get {
  url: {{BASE_URL}}/now
  body: none
  auth: inherit
}

headers {
  Origin: {{NON_TRUSTED_ORIGIN}}
}

assert {
  res.status: eq 403
  res.body: isDefined
  res.body.message: isDefined
  res.body.message: matches {{CORS_REGEX}}
  res.responseTime: lt 200
}
