meta {
  name: ok_same_origin
  type: http
  seq: 2
}

get {
  url: {{BASE_URL}}/now
  body: none
  auth: none
}

headers {
  Origin: {{BASE_URL}}
}

assert {
  res.status: eq 200
  res.body: isDefined
  res.body.now: isDefined
  res.body.now: matches {{RFC_3339_REGEX}}
  res.responseTime: lt 200
}
