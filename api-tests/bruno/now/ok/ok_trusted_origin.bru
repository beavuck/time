meta {
  name: ok_trusted_origin
  type: http
  seq: 1
}

get {
  url: {{BASE_URL}}/now
  body: none
  auth: inherit
}

headers {
  Origin: {{TRUSTED_ORIGIN}}
}

assert {
  res.status: eq 200
  res.body: isDefined
  res.body.now: isDefined
  res.body.now: matches {{RFC_3339_REGEX}}
  res.responseTime: lt 200
}
