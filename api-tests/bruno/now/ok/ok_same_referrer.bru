meta {
  name: ok_same_referrer
  type: http
  seq: 3
}

get {
  url: {{BASE_URL}}/now
  body: none
  auth: none
}

headers {
  Referrer: {{BASE_URL}}
}

assert {
  res.status: eq 200
  res.body: isDefined
  res.body.now: isDefined
  res.body.now: matches {{RFC_3339_REGEX}}
  res.responseTime: lt 200
}
