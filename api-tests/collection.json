        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Response time is less than 200ms\", function () {",
              "  pm.expect(pm.response.responseTime).to.be.below(200);",
              "});",
              "",
              "pm.test(\"Response status code is 403\", function () {",
              "    pm.response.to.have.status(403);",
              "});",
              "",
              "const responseData = pm.response.json();",
              "",
              "pm.test(\"Response body is an object\", function () {",
              "    pm.expect(responseData).to.be.an('object');",
              "});",
              "",
              "pm.test(\"Response object has the attribute 'message'\", function () {",
              "  pm.expect(responseData.message).to.exist;",
              "});",
              "",
              "pm.test(\"Message attribute value contains the word 'CORS'\", function () {",
              "  pm.expect(responseData).to.be.an('object');",
              "  pm.expect(responseData.message).to.match(/cors/i);",
              "});",
              ""
