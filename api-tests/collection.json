              "});",
              "",
              "pm.test(\"Response object has the attribute 'message'\", function () {",
              "  pm.expect(responseData.message).to.exist;",
              "});",
              "",
              "pm.test(\"Message attribute value contains the word 'CORS'\", function () {",
              "  pm.expect(responseData).to.be.an('object');",
              "  pm.expect(responseData.message).to.match(/cors/i);",
              "});",
